# systemd unit for the hosted ledger (capledger ledger serve).
#
#   install -m 0755 bin/capledger /usr/local/bin/capledger
#   install -d -m 0755 /etc/capledger-ledger
#   install -m 0644 ledger.json keyring.json /etc/capledger-ledger/
#   install -m 0644 deploy/ledger/capledger-ledger.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now capledger-ledger
#
# ledger.json and keyring.json hold only token hashes and public keys, so
# they may be world-readable; the service runs as a dynamic user.
#
# Data and the witness key live in /var/lib/capledger-ledger; back it up.
# After enrolling a key in keyring.json: systemctl reload capledger-ledger
# The ledger speaks plain HTTP on localhost here; terminate TLS in front of
# it (nginx, Caddy, a cloud load balancer), or pass --tls-cert and --tls-key.
[Unit]
Description=GPU Sentinel ledger (capledger ledger serve)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/capledger ledger serve \
  --config /etc/capledger-ledger/ledger.json \
  --keyring /etc/capledger-ledger/keyring.json \
  --data /var/lib/capledger-ledger/data \
  --key-dir /var/lib/capledger-ledger/witness \
  --listen 127.0.0.1:8443 \
  --checkpoint-every 24h
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
DynamicUser=yes
StateDirectory=capledger-ledger
StateDirectoryMode=0750
ConfigurationDirectory=capledger-ledger
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
