{
  "apiVersion": "capacity-ledger/v1alpha1",
  "kind": "WebhookMapping",
  "source": "jira-repairs",
  "auth": {
    "hmacSecretFile": "jira-webhook-secret.txt",
    "hmacHeader": "X-Hub-Signature"
  },
  "fields": {
